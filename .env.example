# Historical MVP scope. Never label the live FPL feed as this season.
SEASON=2025-26

# Public CSV ingestion requires no provider keys.
# Configure these only for the corresponding optional feature.
GEMINI_API_KEY=
YOUTUBE_API_KEY=

# Required only when using Neo4j.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
